# Public edge for {{ workout_fqdn }}.
# Coolify application {{ workout_coolify_app_uuid }} on wormmon already routes
# this Host. Direct HTTPS to the upstream returns HTTP 200 for that hostname,
# and certificate verification fails (curl exit 60, X509 issuer error 20).
# Send the public hostname as SNI and do not verify the upstream certificate.
# Visitors still verify the SWAG certificate.
#
# /config/nginx/proxy.conf sets:
#   Host $host
#   X-Real-IP $remote_addr
#   X-Forwarded-For $proxy_add_x_forwarded_for
#   X-Forwarded-Proto https
#   X-Forwarded-Host $host
#   X-Forwarded-Ssl on

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    server_name {{ workout_fqdn }};

    include /config/nginx/ssl.conf;

    client_max_body_size 0;

    location / {
        include /config/nginx/proxy.conf;
        include /config/nginx/resolver.conf;
        proxy_ssl_server_name on;
        proxy_ssl_name {{ workout_fqdn }};
        proxy_ssl_verify off;
        set $upstream_app {{ workout_upstream_ip }};
        set $upstream_port {{ workout_upstream_port }};
        set $upstream_proto https;
        proxy_pass $upstream_proto://$upstream_app:$upstream_port;
    }
}
