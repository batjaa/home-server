# Managed by home-server roles/network/jolly-app. Coolify owns the application.
server {
    listen 80;
    listen [::]:80;
    server_name app.jollyanswer.com;

    location ^~ /.well-known/acme-challenge/ {
        root /config/nginx/acme;
        try_files $uri =404;
    }
    location / {
{% if jolly_app_tls | bool %}
        return 308 https://app.jollyanswer.com$request_uri;
{% else %}
        default_type text/plain;
        return 503 "Jolly app is being deployed. HTTPS will activate when DNS is ready.\n";
{% endif %}
    }
}
{% if jolly_app_tls | bool %}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name app.jollyanswer.com;
    ssl_certificate /config/nginx/jolly-app-letsencrypt/live/app.jollyanswer.com/fullchain.pem;
    ssl_certificate_key /config/nginx/jolly-app-letsencrypt/live/app.jollyanswer.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 2m;

    location / {
        include /config/nginx/proxy.conf;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_pass https://{{ hostvars['wormmon']['ansible_host'] }}:8443;
    }
}
{% endif %}
