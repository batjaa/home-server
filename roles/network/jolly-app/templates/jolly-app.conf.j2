# Managed by home-server roles/network/jolly-app. Coolify owns the application.
server {
    listen 80;
    listen [::]:80;
    server_name *.jollyanswer.com;
    location / {
{% if jolly_app_tls | bool %}
        return 308 https://$host$request_uri;
{% else %}
        default_type text/plain;
        return 503 "Jolly app is being deployed. HTTPS will activate after the Cloudflare nameserver change.\n";
{% endif %}
    }
}
{% if jolly_app_tls | bool %}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name *.jollyanswer.com;
    ssl_certificate /config/nginx/jolly-wildcard-letsencrypt/live/jollyanswer.com/fullchain.pem;
    ssl_certificate_key /config/nginx/jolly-wildcard-letsencrypt/live/jollyanswer.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 2m;

    location / {
        include /config/nginx/proxy.conf;
        proxy_buffering off;
        proxy_pass https://{{ hostvars['wormmon']['ansible_host'] }}:8443;
    }
}
{% endif %}
