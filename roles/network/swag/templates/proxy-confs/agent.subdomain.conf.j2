# Reverse proxy: agent.{{ host }} → host:{{ hermes_dashboard_port | default(9119) }}
# Internal-only — Hermes autonomous-agent dashboard. The bot's task intake is
# Telegram (outbound long-poll, no inbound), so nothing public is needed here.

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    server_name agent.{{ host }};

    include /config/nginx/ssl.conf;
    include /config/nginx/internal-only.conf;

    client_max_body_size 0;

    # Long-running agent streams + live dashboard updates: don't buffer, and let
    # idle connections sit while the agent works.
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_read_timeout 600s;
    proxy_send_timeout 600s;

    location / {
        include /config/nginx/proxy.conf;
        include /config/nginx/resolver.conf;
        set $upstream_app 127.0.0.1;
        set $upstream_port {{ hermes_dashboard_port | default(9119) }};
        set $upstream_proto http;
        proxy_pass $upstream_proto://$upstream_app:$upstream_port;
    }
}
