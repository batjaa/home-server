# Reverse proxy: nextcloud.{{ host }} → host:{{ nextcloud_port | default(8081) }}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    server_name nextcloud.{{ host }};

    include /config/nginx/ssl.conf;

    client_max_body_size 0;

    # Nextcloud-specific headers
    add_header Strict-Transport-Security "max-age=15552000; includeSubDomains" always;

    # Well-known URLs (calendar/contacts auto-discovery)
    location = /.well-known/carddav { return 301 /remote.php/dav/; }
    location = /.well-known/caldav  { return 301 /remote.php/dav/; }

    location / {
        include /config/nginx/proxy.conf;
        include /config/nginx/resolver.conf;
        set $upstream_app 127.0.0.1;
        set $upstream_port {{ nextcloud_port | default(8081) }};
        set $upstream_proto http;
        proxy_pass $upstream_proto://$upstream_app:$upstream_port;

        # Nextcloud upload requirements
        proxy_max_temp_file_size 2048m;
        proxy_request_buffering off;
        proxy_buffering off;
    }
}
