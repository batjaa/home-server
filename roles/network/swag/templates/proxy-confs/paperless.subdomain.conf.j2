# Reverse proxy: paperless.{{ host }} → host:{{ paperless_port | default(8083) }}
# Internal-only — admin doc store, no Cloudflare CNAME.

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    server_name paperless.{{ host }};

    include /config/nginx/ssl.conf;

    # Allow large uploads (scanned PDFs, multi-page TIFFs)
    client_max_body_size 100M;

    location / {
        include /config/nginx/proxy.conf;
        include /config/nginx/resolver.conf;
        set $upstream_app 127.0.0.1;
        set $upstream_port {{ paperless_port | default(8083) }};
        set $upstream_proto http;
        proxy_pass $upstream_proto://$upstream_app:$upstream_port;
    }
}
