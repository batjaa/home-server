# Reverse proxy: deploy.{{ host }} → wormmon:{{ hostvars['wormmon']['coolify_app_port'] | default(8000) }}
# Public Coolify control plane, proxied through andromon so router 80/443 stays here.

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    server_name deploy.{{ host }};

    include /config/nginx/ssl.conf;

    client_max_body_size 0;

    location / {
        include /config/nginx/proxy.conf;
        include /config/nginx/resolver.conf;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        set $upstream_app {{ hostvars['wormmon']['ansible_host'] }};
        set $upstream_port {{ hostvars['wormmon']['coolify_app_port'] | default(8000) }};
        set $upstream_proto http;
        proxy_pass $upstream_proto://$upstream_app:$upstream_port;
    }
}
