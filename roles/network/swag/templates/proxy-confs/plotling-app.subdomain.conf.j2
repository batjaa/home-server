# Reverse proxy: plotling.app → wormmon:443. Coolify routes the original Host
# to Plotling's production deployment. Keep www as a permanent apex redirect.

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    server_name www.plotling.app;

    include /config/nginx/ssl.conf;

    return 308 https://plotling.app$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    server_name plotling.app;

    include /config/nginx/ssl.conf;

    client_max_body_size 0;

    location / {
        include /config/nginx/proxy.conf;
        include /config/nginx/resolver.conf;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        set $upstream_app {{ hostvars['wormmon']['ansible_host'] }};
        set $upstream_port 443;
        set $upstream_proto https;
        proxy_pass $upstream_proto://$upstream_app:$upstream_port;
    }
}
