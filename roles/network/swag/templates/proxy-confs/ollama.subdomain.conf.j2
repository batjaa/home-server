# Reverse proxy: ollama.{{ host }} → greymon:11434
# Internal-only — no Cloudflare CNAME, only Pi-hole resolves it.
# Upstream is greymon (Windows, not Ansible-managed). Ollama must be started
# with OLLAMA_HOST=0.0.0.0:11434 and Windows Firewall must allow TCP 11434
# from the LAN. See README "AI / inference".

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    server_name ollama.{{ host }};

    include /config/nginx/ssl.conf;
    include /config/nginx/internal-only.conf;

    client_max_body_size 0;

    # Streaming completions can take minutes on large prompts. Disable nginx
    # response buffering so tokens stream to the client as Ollama emits them,
    # and lift the read timeout well past the default 60s.
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_read_timeout 600s;
    proxy_send_timeout 600s;

    location / {
        include /config/nginx/proxy.conf;
        include /config/nginx/resolver.conf;
        set $upstream_app 192.168.50.30;
        set $upstream_port 11434;
        set $upstream_proto http;
        proxy_pass $upstream_proto://$upstream_app:$upstream_port;
    }
}
