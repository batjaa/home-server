# Reverse proxy: dbdiagram.{{ host }} → host:{{ chartdb_port | default(3012) }}
# Public — ChartDB self-hosted has no built-in user accounts.

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    server_name dbdiagram.{{ host }};

    include /config/nginx/ssl.conf;

    client_max_body_size 0;

    location / {
        include /config/nginx/proxy.conf;
        include /config/nginx/resolver.conf;
        set $upstream_app 127.0.0.1;
        set $upstream_port {{ chartdb_port | default(3012) }};
        set $upstream_proto http;
        proxy_pass $upstream_proto://$upstream_app:$upstream_port;
    }
}
