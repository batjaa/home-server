# Production applications on wormmon, managed by Coolify.
{% for domain in ['fotopass.app', 'mytendies.app', 'tech-nomads.io', 'tsas.mn'] %}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.{{ domain }};
    include /config/nginx/ssl.conf;
    return 308 https://{{ domain }}$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{ domain }};
    include /config/nginx/ssl.conf;
    client_max_body_size 0;

    location / {
        include /config/nginx/proxy.conf;
        include /config/nginx/resolver.conf;
        set $upstream_app {{ hostvars['wormmon']['ansible_host'] }};
        proxy_pass https://$upstream_app:443;
    }
}
{% endfor %}

# Preserve Heyanda's existing wildcard hosts. Coolify selects the application
# using the canonical upstream Host; Laravel sees the original forwarded host.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name .heyanda.mn;
    include /config/nginx/ssl.conf;
    client_max_body_size 0;

    location / {
        include /config/nginx/resolver.conf;
        proxy_http_version 1.1;
        proxy_connect_timeout 240;
        proxy_read_timeout 240;
        proxy_send_timeout 240;
        proxy_buffering off;
        proxy_set_header Host heyanda.mn;
        proxy_set_header Proxy "";
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        set $upstream_app {{ hostvars['wormmon']['ansible_host'] }};
        proxy_pass https://$upstream_app:443;
    }
}
