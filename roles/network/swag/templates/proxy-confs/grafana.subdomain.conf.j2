# Reverse proxy: grafana.{{ host }} → host:{{ grafana_port | default(3000) }}
# Internal-only — no Cloudflare CNAME, only Pi-hole resolves it.

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    server_name grafana.{{ host }};

    include /config/nginx/ssl.conf;

    client_max_body_size 0;

    location / {
        include /config/nginx/proxy.conf;
        include /config/nginx/resolver.conf;
        set $upstream_app 127.0.0.1;
        set $upstream_port {{ grafana_port | default(3000) }};
        set $upstream_proto http;
        proxy_pass $upstream_proto://$upstream_app:$upstream_port;
    }

    # Live/Streaming endpoint (websockets) for Grafana Live
    location /api/live/ {
        include /config/nginx/proxy.conf;
        include /config/nginx/resolver.conf;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        set $upstream_app 127.0.0.1;
        set $upstream_port {{ grafana_port | default(3000) }};
        set $upstream_proto http;
        proxy_pass $upstream_proto://$upstream_app:$upstream_port;
    }
}
