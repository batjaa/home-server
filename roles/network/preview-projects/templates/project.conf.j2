# Managed from vars/preview-projects.json; application hosts are registered in Coolify.
server {
    listen 80;
    listen [::]:80;
    server_name {{ preview_domain }} *.{{ preview_domain }};
    return 308 https://$host$request_uri;
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{ preview_domain }} *.{{ preview_domain }};
    ssl_certificate /config/nginx/preview-letsencrypt/live/{{ preview_domain }}/fullchain.pem;
    ssl_certificate_key /config/nginx/preview-letsencrypt/live/{{ preview_domain }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    client_max_body_size 10m;
    location / {
        include /config/nginx/proxy.conf;
        proxy_buffering off;
        proxy_pass https://{{ preview_target.upstream_host }}:{{ preview_target.upstream_port }};
    }
}
