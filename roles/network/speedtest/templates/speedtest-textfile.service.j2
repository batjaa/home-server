[Unit]
Description=Sample internet speed via Ookla CLI for Prometheus textfile collector
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Ookla speedtest CLI crashes with `basic_string null not valid` when TERM
# is unset, which is the default under systemd. HOME is needed for the
# EULA-acceptance cache (~/.config/Ookla/speedtest-cli/).
Environment=TERM=dumb
Environment=HOME=/root
{% if speedtest_server_id %}
Environment=SPEEDTEST_SERVER_ID={{ speedtest_server_id }}
{% endif %}
ExecStart=/usr/local/sbin/speedtest-textfile
StandardOutput=journal
StandardError=journal
