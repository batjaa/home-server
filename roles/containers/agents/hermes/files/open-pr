#!/usr/bin/env python3
"""open-pr "<title>" ["<body>"]

Open a GitHub pull request for the CURRENT git branch against the base branch
(default: main), using $GITHUB_TOKEN. Deterministic + idempotent — the Hermes
worker calls this instead of hand-writing a curl, which the local model gets
wrong. Prints the PR url. If a PR is already open for the branch, prints it and
exits 0.

Deployed to /opt/data/bin/open-pr in the Hermes container by the role.
"""
import json
import os
import re
import subprocess
import sys
import urllib.error
import urllib.request


def sh(*args):
    return subprocess.check_output(args, text=True).strip()


def main():
    if len(sys.argv) < 2 or not sys.argv[1].strip():
        sys.exit('usage: open-pr "<title>" ["<body>"]')
    title = sys.argv[1]
    body = sys.argv[2] if len(sys.argv) > 2 else "Opened by the Hermes agent."
    base = os.environ.get("PR_BASE", "main")

    remote = sh("git", "config", "--get", "remote.origin.url")

    # Prefer the env token; fall back to the token baked into the authenticated
    # remote url (Hermes doesn't always pass GITHUB_TOKEN into the worker shell).
    token = os.environ.get("GITHUB_TOKEN")
    if not token:
        m = re.search(r"://[^:/]+:([^@]+)@", remote)
        token = m.group(1) if m else None
    if not token:
        sys.exit("no GitHub token (GITHUB_TOKEN unset and none in remote url)")

    repo = remote.replace("git@github.com:", "").replace("https://github.com/", "")
    repo = repo[:-4] if repo.endswith(".git") else repo
    if "@github.com/" in repo:           # strip token-in-url (x-access-token:TOKEN@github.com/owner/repo)
        repo = repo.split("@github.com/", 1)[1]
    owner = repo.split("/")[0]
    branch = sh("git", "rev-parse", "--abbrev-ref", "HEAD")
    api = f"https://api.github.com/repos/{repo}/pulls"
    headers = {"Authorization": f"token {token}", "Accept": "application/vnd.github+json"}

    def call(url, data=None, method=None):
        req = urllib.request.Request(
            url,
            data=json.dumps(data).encode() if data is not None else None,
            headers=headers,
            method=method,
        )
        with urllib.request.urlopen(req) as resp:
            return json.load(resp)

    existing = call(f"{api}?head={owner}:{branch}&state=open")
    if existing:
        print(f"PR already open: {existing[0]['html_url']}")
        return
    try:
        pr = call(api, {"title": title, "head": branch, "base": base, "body": body}, "POST")
        print(pr["html_url"])
    except urllib.error.HTTPError as e:
        sys.exit(f"PR creation failed: HTTP {e.code} {e.read().decode()[:400]}")


if __name__ == "__main__":
    main()
