# Service tiles — grouped per layout section in settings.yaml.
# Pings are local container ports so widgets stay green even if SWAG is down.
# Widget API keys come from host_vars/andromon/secret.yml.

- Media:
    - Plex:
        icon: plex.png
        href: https://plex.batjaa.site
        description: movies, TV, music
        siteMonitor: http://127.0.0.1:32400/identity
        widget:
          type: plex
          url: http://127.0.0.1:32400
          key: {{ plex_token }}
    - Jellyfin:
        icon: jellyfin.png
        href: https://jellyfin.batjaa.site
        description: open-source video alternative
        siteMonitor: http://127.0.0.1:8096/health
    - Navidrome:
        icon: navidrome.png
        href: https://music.batjaa.site
        description: music streaming
        siteMonitor: http://127.0.0.1:4533/ping
    - Tautulli:
        icon: tautulli.png
        href: https://tautulli.batjaa.site
        description: Plex stats + transcode count
        siteMonitor: http://127.0.0.1:8181/
        widget:
          type: tautulli
          url: http://127.0.0.1:8181
          key: {{ tautulli_api_key }}
          # Show active streams + how many are transcoding. With Plex GPU
          # passthrough working, transcoding count > 0 paired with low CPU =
          # hardware acceleration is engaged.
          fields:
            - streams
            - transcodes
            - movies
            - tv

- Files & Photos:
    - Immich:
        icon: immich.png
        href: https://photos.batjaa.site
        description: photos + memories
        siteMonitor: http://127.0.0.1:2283/api/server/ping
        # Built-in `type: immich` calls /api/server-info/* which Immich 2.x
        # removed (404). Use customapi against the current /api/server/* paths.
        widget:
          type: customapi
          url: http://127.0.0.1:2283/api/server/statistics
          method: GET
          headers:
            x-api-key: {{ immich_api_key }}
          display: list
          mappings:
            - field: photos
              label: photos
              format: number
            - field: videos
              label: videos
              format: number
            - field: usage
              label: usage
              format: bytes
    - Nextcloud:
        icon: nextcloud.png
        href: https://nextcloud.batjaa.site
        description: files, calendar, contacts
        siteMonitor: http://127.0.0.1:8081/status.php
        widget:
          type: nextcloud
          url: https://nextcloud.batjaa.site
          username: {{ nextcloud_admin_user | default('batjaa') }}
          password: {{ nextcloud_admin_password }}

- Automation:
    - Seerr:
        icon: jellyseerr.png
        href: https://request.batjaa.site
        description: friend request UI
        siteMonitor: http://127.0.0.1:5055/
    - Sonarr:
        icon: sonarr.png
        href: https://sonarr.batjaa.site
        description: TV automation
        siteMonitor: http://127.0.0.1:8989/
        widget:
          type: sonarr
          url: http://127.0.0.1:8989
          key: {{ sonarr_api_key }}
    - Radarr:
        icon: radarr.png
        href: https://radarr.batjaa.site
        description: movie automation
        siteMonitor: http://127.0.0.1:7878/
        widget:
          type: radarr
          url: http://127.0.0.1:7878
          key: {{ radarr_api_key }}
    - Prowlarr:
        icon: prowlarr.png
        href: https://prowlarr.batjaa.site
        description: indexer manager
        siteMonitor: http://127.0.0.1:9696/
        widget:
          type: prowlarr
          url: http://127.0.0.1:9696
          key: {{ prowlarr_api_key }}
    - SABnzbd:
        icon: sabnzbd.png
        href: https://sabnzbd.batjaa.site
        description: usenet client
        siteMonitor: http://127.0.0.1:8082/
        widget:
          type: sabnzbd
          url: http://127.0.0.1:8082
          key: {{ sabnzbd_api_key }}
    - Bazarr:
        icon: bazarr.png
        href: https://bazarr.batjaa.site
        description: subtitles
        siteMonitor: http://127.0.0.1:6767/
        widget:
          type: bazarr
          url: http://127.0.0.1:6767
          key: {{ bazarr_api_key }}
    - Beets:
        icon: beets.png
        href: https://beets.batjaa.site
        description: music tagger
        siteMonitor: http://127.0.0.1:8337/

- GPU & Transcoding:
    - Plex transcoding:
        icon: plex.png
        href: https://tautulli.batjaa.site
        description: live HW vs SW transcode count
        widget:
          type: customapi
          url: http://127.0.0.1:8181/api/v2?cmd=get_activity&apikey={{ tautulli_api_key }}
          mappings:
            - field:
                response:
                  data: stream_count
              label: streams
            - field:
                response:
                  data: stream_count_direct_play
              label: direct play
            - field:
                response:
                  data: transcode_count
              label: transcoding
    - Jellyfin sessions:
        icon: jellyfin.png
        href: https://jellyfin.batjaa.site
        description: active sessions
        widget:
          type: jellyfin
          url: http://127.0.0.1:8096
          key: {{ jellyfin_api_key | default('') }}
          fields:
            - movies
            - series
            - episodes
          enableNowPlaying: true
          enableBlocks: true

- Monitoring:
    - Grafana:
        icon: grafana.png
        href: https://grafana.batjaa.site
        description: dashboards
        siteMonitor: http://127.0.0.1:3000/api/health
    - Prometheus:
        icon: prometheus.png
        href: http://127.0.0.1:9090
        description: metrics TSDB
        siteMonitor: http://127.0.0.1:9090/-/healthy
    - Uptime Kuma:
        icon: uptime-kuma.png
        href: https://status.batjaa.site
        description: status page + alerts (tentomon)
        siteMonitor: http://{{ hostvars['tentomon']['ansible_host'] }}:3001/
    - cAdvisor:
        icon: cadvisor.png
        href: http://127.0.0.1:8080
        description: container metrics
        siteMonitor: http://127.0.0.1:8080/healthz
    - Speedtest:
        icon: si-speedtest
        href: https://grafana.batjaa.site/d/speedtest
        description: hourly Ookla CLI sample
        widget:
          type: customapi
          # PromQL converts bytes/s to Mbps so the tile matches what Ziply quotes.
          # Homepage runs network_mode=host, so it can't resolve container DNS
          # ("prometheus") — hit Prometheus on its localhost-published port.
          url: http://127.0.0.1:9090/api/v1/query?query=speedtest_download_bytes_per_second*8/1000000
          display: list
          mappings:
            # Dot-notation path through Prometheus's instant-query response:
            # data.result is an array; [0].value is [<timestamp>, "<value-as-string>"];
            # [1] is the value. Homepage parses "494.806" via format:number.
            - field: data.result.0.value.1
              label: down Mbps
              format: number

- Infrastructure:
    - Pi-hole:
        icon: pi-hole.png
        href: http://192.168.50.10/admin
        description: DNS + ad blocking (tentomon)
        # No siteMonitor: Pi-hole v6's embedded HTTP server emits a
        # malformed "Connection: close" framing that Node.js refuses to
        # parse. The widget below reports liveness implicitly.
        widget:
          type: pihole
          url: http://192.168.50.10
          version: 6
          key: {{ hostvars['tentomon']['pihole_password'] }}
    - PiKVM (andromon):
        icon: pikvm.png
        href: https://kvm.andromon.home.local
        description: out-of-band recovery — andromon
    - PiKVM (greymon):
        icon: pikvm.png
        href: https://kvm.greymon.home.local
        description: out-of-band recovery — greymon
    - PiKVM (wormmon):
        icon: pikvm.png
        href: https://kvm.wormmon.home.local
        description: out-of-band recovery — wormmon (planned)
    - SWAG:
        icon: swag.png
        href: https://{{ host }}
        description: reverse proxy + SSL
        # No siteMonitor: SWAG redirects http://127.0.0.1/ to https, which
        # Homepage's HTTP probe refuses to follow (cross-protocol upgrade).
