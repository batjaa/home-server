# Top-of-page info widgets
# Disk widgets read statvfs() inside the container — point them at the
# underlying filesystems (not the mergerfs unions, which are fuse mounts).
- resources:
    cpu: true
    memory: true
    disk: /
    label: NVMe
- resources:
    label: HDD primary
    disk: /mnt/sda1
- resources:
    label: HDD backup
    disk: /mnt/backup1
- search:
    provider: duckduckgo
    target: _blank
- datetime:
    text_size: xl
    locale: en
    format:
      timeStyle: short
      dateStyle: medium
