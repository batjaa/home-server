# Homepage — layout, theme, branding
title: home.batjaa.site
description: home server

# Show services and bookmarks in columns
layout:
  Media:
    style: row
    columns: 4
  Files & Photos:
    style: row
    columns: 3
  Automation:
    style: row
    columns: 3
  GPU & Transcoding:
    style: row
    columns: 2
  Monitoring:
    style: row
    columns: 4
  Infrastructure:
    style: row
    columns: 4

theme: dark
color: slate

# Show timestamps on widget data
useEqualHeights: true
hideVersion: true
