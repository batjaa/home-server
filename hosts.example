[pi]
tentomon ansible_host=192.168.50.10 ansible_user=tentomon ansible_connection=ssh ansible_ssh_private_key_file=~/.ssh/id_ed25519

[homeservers]
andromon ansible_host=192.168.50.20 ansible_user=batjaa ansible_connection=ssh ansible_ssh_private_key_file=~/.ssh/id_ed25519
wormmon ansible_host=192.168.50.40 ansible_user=batjaa ansible_connection=ssh ansible_ssh_private_key_file=~/.ssh/id_ed25519

# Only pikvm-ssh.yml targets these factory-image recovery devices.
[pikvm]
kvm.andromon ansible_host=192.168.50.21 ansible_user=root ansible_port=22
kvm.greymon ansible_host=192.168.50.31 ansible_user=root ansible_port=22
kvm.wormmon ansible_host=192.168.50.41 ansible_user=root ansible_port=22
