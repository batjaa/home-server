<?php
require '/var/www/html/vendor/autoload.php';
$app=require '/var/www/html/bootstrap/app.php';
$app->make(Illuminate\Contracts\Console\Kernel::class)->bootstrap();
$service=App\Models\Service::where('uuid','rfu19wpoa6yajpckvqunvmct')->firstOrFail();
$server=App\Models\Server::where('name','tech-nomads')->firstOrFail();
$project=$service->environment->project;
if ($project->uuid !== 'tqq5l64fyesfweabao1vvkne' || $server->team_id !== 2 || !$server->settings->is_usable) throw new RuntimeException('Migration precondition failed');
if (!in_array($service->server_id,[0,$server->id]) || !in_array($project->team_id,[0,2])) throw new RuntimeException('Unexpected ownership');
Illuminate\Support\Facades\Auth::login(App\Models\User::findOrFail(0));
session(['currentTeam'=>App\Models\Team::findOrFail(2)]);
$changed=$service->server_id !== $server->id || $project->team_id !== 2;
if ($changed) {
    Illuminate\Support\Facades\DB::transaction(function() use($service,$server,$project) {
        $destination=App\Models\StandaloneDocker::where('server_id',$server->id)->firstOrFail();
        $project->team_id=2;$project->save();
        $service->server_id=$server->id;$service->destination_id=$destination->id;$service->save();
        App\Models\SharedEnvironmentVariable::where('project_id',$project->id)->update(['team_id'=>2]);
    });
    $service->refresh();
    $activity=App\Actions\Service\StartService::run($service);
    echo 'CHANGED moved Jolly; deployment activity '.$activity->id.PHP_EOL;
} else echo "OK Jolly already belongs to Tech Nomads\n";
